generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cooperativa {
  id                        String                            @id @default(cuid())
  nome                      String
  cnpj                      String                            @unique
  email                     String?
  telefone                  String?
  endereco                  String?
  numero                    String?
  bairro                    String?
  cidade                    String?
  estado                    String?
  cep                       String?
  ativo                     Boolean                           @default(true)
  tipoParceiro              String                            @default("COOPERATIVA") // COOPERATIVA | CONSORCIO | ASSOCIACAO | CONDOMINIO
  tiposOperacao             String[]                          @default([]) // USINA_PROPRIA | CONDOMINIO | EMPRESA | CARREGADOR_VEICULAR
  // Multa e juros
  multaAtraso               Decimal                           @default(2.0) @db.Decimal(5, 2)
  jurosDiarios              Decimal                           @default(0.033) @db.Decimal(5, 3)
  diasCarencia              Int                               @default(3)
  intervaloMinCobrancaHoras Int                               @default(24)
  // SaaS
  planoSaasId               String?
  planoSaas                 PlanoSaas?                        @relation(fields: [planoSaasId], references: [id])
  diaVencimentoSaas         Int                               @default(10)
  statusSaas                String                            @default("ATIVO") // ATIVO | INADIMPLENTE | SUSPENSO | TRIAL
  // ── Módulos ativos (cache do plano) ──
  modulosAtivos             String[]                          @default([])
  modalidadesAtivas         Json                              @default("{}")
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  configuracoesCobranca     ConfiguracaoCobranca[]
  usinas                    Usina[]                           @relation("CooperativaUsinas")
  configGateways            ConfigGateway[]
  asaasConfig               AsaasConfig?
  faturasSaas               FaturaSaas[]
  modelosDocumento          ModeloDocumento[]
  configIndicacao           ConfigIndicacao?
  indicacoes                Indicacao[]
  usuarios                  Usuario[]
  cooperados                Cooperado[]
  configuracoesNotificacao  ConfiguracaoNotificacaoCobranca[]
  contratos                 Contrato[]                        @relation("ContratoCooperativa")
  // Bloco 5 (24/05) — Solicitacoes via WhatsApp aguardando admin aprovar
  solicitacoesAlteracaoContrato SolicitacaoAlteracaoContrato[]
  // Bloco 8 (24/05) — Confirmacoes de pagamento via "ja paguei" do menu fatura
  solicitacoesConfirmacaoPagamento SolicitacaoConfirmacaoPagamento[]
  administradoras           Administradora[]
  condominios               Condominio[]
  configClubeVantagens      ConfigClubeVantagens?
  transferencias            TransferenciaPix[]
  migracoesUsina            MigracaoUsina[]
  enviosLista               EnvioListaConcessionaria[]
  // ── CooperToken ──
  cooperTokenLedger         CooperTokenLedger[]
  configCooperToken         ConfigCooperToken?
  cooperTokenSaldoParceiro  CooperTokenSaldoParceiro?
  convitesIndicacao         ConviteIndicacao[]
  ofertasClube              OfertaClube[]
  contasAPagar              ContaAPagar[]
  repassesProprietario      RepasseProprietario[]
  historicosStatusCooperado HistoricoStatusCooperado[]
  bandeirasTarifarias       BandeiraTarifaria[]
  politicaBandeira          PoliticaBandeira                  @default(DECIDIR_MENSAL)
  /// @deprecated Substituído por politicaBandeira. Remover no Sprint 6 após eliminar engine órfã calcularCobrancaMensal.
  bandeiraAtiva             Boolean                           @default(false)
  bandeiraSincronizacaoAuto Boolean                           @default(false)
  // ── Sprint 8 — Realocação Multi-Usina (Engine Otimização Proativa) ──
  politicasAlocacao         PoliticaAlocacao[]
  alocacoesOtimas           AlocacaoOtima[]

  // ── D-novo-BH (M37, 2026-05-29) — Despesas Operacionais Camada 2 ──
  // Quando true, proprietário vê tela /proprietario/despesas + pode propor.
  // Quando false, módulo de despesas operacionais fica restrito ao admin.
  proprietarioVeDespesas    Boolean                           @default(true)

  // ── Sprint CT.1 (31/05/2026) — Contabilidade Tributária Segregada ──
  // regimeContabil derivado de tipoParceiro no momento do cadastro;
  // editável por SUPER_ADMIN pra casos de borda. Vide
  // docs/relatorios/2026-05-31-conformidade-contabil-multi-regime.md secao 7.
  regimeContabil            TipoRegimeContabil                @default(COOPERATIVO)
  // P0-4: STF Tema 536 em julgamento mai/jun 2026. Isenção PIS/COFINS sobre
  // ato cooperativo próprio = flag configurável (NÃO hardcoded). Default true
  // pra COOPERATIVA (jurisprudência atual STF); false pros demais regimes.
  isencaoPisCofinsAtiva     Boolean                           @default(true)

  convenios                 Convenio[]
  apuracoesMensaisSegregadas ApuracaoMensalSegregada[]

  @@map("cooperativas")
}

model Usuario {
  id               String            @id @default(cuid())
  nome             String
  email            String            @unique
  cpf              String?           @unique
  telefone         String?           @unique
  supabaseId       String?           @unique
  perfil           PerfilUsuario     @default(COOPERADO)
  ativo            Boolean           @default(true)
  fotoFacialUrl    String?
  resetToken       String?           @unique
  resetTokenExpiry DateTime?
  cooperativaId    String?
  cooperativa      Cooperativa?      @relation(fields: [cooperativaId], references: [id])
  administradoraId String?
  administradora   Administradora?   @relation(fields: [administradoraId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  observacoes      ObservacaoAtiva[]
  enviosValidados  EnvioListaConcessionaria[] @relation("EnvioListaValidador")
  enviosEnviados   EnvioListaConcessionaria[] @relation("EnvioListaEnviador")

  // ── D-novo-BH (M37, 2026-05-29) — Workflow despesas operacionais ──
  despesasPropostas   ContaAPagar[] @relation("DespesaPropostoPor")
  despesasAprovadas   ContaAPagar[] @relation("DespesaAprovadoPor")

  // ── D-novo-AN (M42, 2026-05-30) — RepasseProprietario ──
  repassesProprietario     RepasseProprietario[] @relation("RepasseProprietarioUsuario")
  repassesRegistrados      RepasseProprietario[] @relation("RepasseRegistradoPor")
  repassesCancelados       RepasseProprietario[] @relation("RepasseCanceladoPor")

  @@map("usuarios")
}

enum PerfilUsuario {
  SUPER_ADMIN
  ADMIN
  OPERADOR
  COOPERADO
  AGREGADOR
  PROPRIETARIO // Sub-Sprint F (M30, 2026-05-26): proprietario de usina (E-Solares, etc) que arrenda usina pra cooperativa. Acessa /proprietario (root) — leitura pura.
}

model Cooperado {
  id                      String                     @id @default(cuid())
  nomeCompleto            String
  cpf                     String                     @unique
  email                   String                     @unique
  telefone                String?
  status                  StatusCooperado            @default(PENDENTE)
  cotaKwhMensal           Decimal?                   @db.Decimal(10, 2)
  documento               String?
  tipoDocumento           String?
  preferenciaCobranca     String?
  tipoCooperado           TipoCooperado              @default(COM_UC)
  termoAdesaoAceito       Boolean                    @default(false)
  termoAdesaoAceitoEm     DateTime?
  usinaPropriaId          String?
  percentualRepasse       Decimal?                   @db.Decimal(5, 2)
  cooperativaId           String?
  cooperativa             Cooperativa?               @relation(fields: [cooperativaId], references: [id])
  dataInicioCreditos      DateTime?
  protocoloConcessionaria String?
  representanteLegalNome  String?
  representanteLegalCpf   String?
  representanteLegalCargo String?
  tipoPessoa              String?                    @default("PF")
  dataNascimento          DateTime?
  razaoSocial             String?
  cep                     String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cidade                  String?
  estado                  String?
  // Segurança LGPD em dev: true = não dispara notificações reais
  ambienteTeste           Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  ucs                     Uc[]
  contratos               Contrato[]
  ocorrencias             Ocorrencia[]
  faturasProcessadas      FaturaProcessada[]
  documentos              DocumentoCooperado[]
  notificacoes            Notificacao[]
  propostas               PropostaCooperado[]
  listaEspera             ListaEspera[]
  prestadores             Prestador[]
  lancamentos             LancamentoCaixa[]
  contratosUso            ContratoUso[]
  convenios               ConvenioCooperado[]
  conveniosRepresentados  ContratoConvenio[]         @relation("ConveniadoConvenio")
  formaPagamento          FormaPagamentoCooperado?
  cobrancasBancarias      CobrancaBancaria[]
  usinasProprietario      Usina[]                    @relation("UsinaProprietario")
  asaasCustomer           AsaasCustomer?
  asaasCobrancas          AsaasCobranca[]
  cobrancasGateway        CobrancaGateway[]
  pixChave                String?
  pixTipo                 String?
  // Indicações MLM
  codigoIndicacao         String                     @unique @default(cuid())
  cooperadoIndicadorId    String?
  indicacoesFeitas        Indicacao[]                @relation("IndicacoesFeitas")
  indicacoesRecebidas     Indicacao[]                @relation("IndicacoesRecebidas")
  beneficiosIndicacao     BeneficioIndicacao[]
  // Bloco 5 (24/05) — Solicitacoes de alteracao de contrato via WhatsApp
  solicitacoesAlteracaoContrato SolicitacaoAlteracaoContrato[]
  // Bloco 8 (24/05) — Confirmacoes de pagamento via "ja paguei"
  solicitacoesConfirmacaoPagamento SolicitacaoConfirmacaoPagamento[]
  progressaoClube         ProgressaoClube?
  unidadesCondominio      UnidadeCondominio[]
  transferencias          TransferenciaPix[]
  migracoesUsina          MigracaoUsina[]
  enviosLista             EnvioListaCooperado[]
  // Token de assinatura remota (cadastro por proxy)
  tokenAssinatura         String?
  tokenAssinaturaExp      DateTime?
  // ── CooperToken ──
  modoRemuneracao         ModoRemuneracao            @default(DESCONTO)
  /// @deprecated Substituído por modoRemuneracao. Manter por compatibilidade até Sprint 9.
  opcaoToken              String                     @default("A")
  cooperTokenLedger       CooperTokenLedger[]
  cooperTokenSaldo        CooperTokenSaldo?
  convitesEnviados        ConviteIndicacao[]         @relation("ConvitesEnviados")
  conversoesCreditoSemUc  ConversaoCreditoSemUc[]
  resgatesClubeVantagens  ResgateClubeVantagens[]
  historicoStatus         HistoricoStatusCooperado[]
  // ── Faturas Concessionária (e-mail monitor) ──
  emailFaturasAtivo       Boolean                    @default(false)
  emailFaturasAtivoEm     DateTime?
  emailFaturasObservacao  String?

  @@map("cooperados")
}

model DocumentoCooperado {
  id             String          @id @default(cuid())
  cooperadoId    String
  cooperado      Cooperado       @relation(fields: [cooperadoId], references: [id])
  tipo           TipoDocumento
  url            String
  nomeArquivo    String?
  tamanhoBytes   Int?
  status         StatusDocumento @default(PENDENTE)
  motivoRejeicao String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([cooperadoId, tipo])
  @@map("documentos_cooperados")
}

enum TipoDocumento {
  RG_FRENTE
  RG_VERSO
  CNH_FRENTE
  CNH_VERSO
  CONTRATO_SOCIAL
  OUTROS
}

enum StatusDocumento {
  PENDENTE
  APROVADO
  REPROVADO
}

enum StatusCooperado {
  PENDENTE_ASSINATURA
  PENDENTE
  PENDENTE_VALIDACAO
  PENDENTE_DOCUMENTOS
  AGUARDANDO_CONCESSIONARIA
  APROVADO
  ATIVO
  ATIVO_RECEBENDO_CREDITOS
  SUSPENSO
  ENCERRADO
}

enum TipoCooperado {
  COM_UC
  SEM_UC
  GERADOR
  CARREGADOR_VEICULAR
  USUARIO_CARREGADOR
}

// ─── Convênios ─────────────────────────────────────────────────────────────

enum TipoConvenio {
  CONDOMINIO
  ADMINISTRADORA
  ASSOCIACAO
  SINDICATO
  EMPRESA
  CLUBE
  OUTRO
}

enum StatusConvenio {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum StatusMembroConvenio {
  MEMBRO_ATIVO
  MEMBRO_SUSPENSO
  MEMBRO_DESLIGADO
}

enum EfeitoMudancaFaixa {
  SOMENTE_PROXIMAS
  INCLUIR_PENDENTES
}

model Uc {
  id                  String             @id @default(cuid())
  // Sprint 11 — Arquitetura UC: 3 campos principais
  // numero       — canônico SISGD (10 dígitos, ex: 0400702214). Identificação única dentro do sistema.
  // numeroUC     — legado da concessionária (9 dígitos, ex: 160085263). Usado em listas B2B de compensação.
  // distribuidora— concessionária responsável (obrigatório, enum). Determina formato e regras de match.
  numero              String             @unique
  endereco            String
  cidade              String
  estado              String
  numeroUC            String?
  // Número exato como aparece na fatura da concessionária (formato preservado, sem normalização).
  // Ex EDP ES atual: "0.000.512.828.054-91" (15 díg + DV com pontuação que não cabe em `numero` ou `numeroUC`).
  numeroConcessionariaOriginal String?    @db.VarChar(50)
  codigoMedidor       String?
  cep                 String?
  bairro              String?
  distribuidora       DistribuidoraEnum  @default(OUTRAS)
  classificacao       String?
  modalidadeTarifaria String?
  tensaoNominal       String?
  tipoFornecimento    String?
  cooperadoId         String
  cooperado           Cooperado          @relation(fields: [cooperadoId], references: [id])
  cooperativaId       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  contratos           Contrato[]
  ocorrencias         Ocorrencia[]
  faturasProcessadas  FaturaProcessada[]

  @@map("ucs")
}

enum DistribuidoraEnum {
  EDP_ES
  EDP_SP
  CEMIG
  ENEL_SP
  LIGHT_RJ
  CELESC
  OUTRAS
}

model Usina {
  id                      String                    @id @default(cuid())
  nome                    String
  // Bloco H' (16/05/2026): apelido interno (ex: "cooperebr1" / "cooperebr2") — não substitui nome ANEEL
  // Mini-Sprint Bugs Usinas+Listas (17/05/2026 noite): @unique impede recorrência da duplicação Cooperebr2
  apelidoInterno          String?                   @unique
  potenciaKwp             Decimal                   @db.Decimal(10, 2)
  capacidadeKwh           Decimal?                  @db.Decimal(15, 2)
  producaoMensalKwh       Decimal?                  @db.Decimal(15, 2)
  cidade                  String
  estado                  String
  // Bloco H': endereço completo (cidade + estado já existiam)
  enderecoLogradouro      String?
  enderecoNumero          String?
  enderecoBairro          String?
  enderecoCep             String?
  statusHomologacao       StatusUsina               @default(CADASTRADA)
  dataHomologacao         DateTime?
  dataInicioProducao      DateTime?
  observacoes             String?
  modeloCobrancaOverride  ModeloCobranca?
  politicaBandeira        PoliticaBandeira? // null = herda da Cooperativa (cascata)
  distribuidora           String?
  cooperativaId           String?
  cooperativa             Cooperativa?              @relation("CooperativaUsinas", fields: [cooperativaId], references: [id])
  // Proprietário da usina
  proprietarioNome        String?
  proprietarioCpfCnpj     String?
  proprietarioTelefone    String?
  proprietarioEmail       String?
  proprietarioTipo        String                    @default("PF")
  proprietarioCooperadoId String?
  proprietarioCooperado   Cooperado?                @relation("UsinaProprietario", fields: [proprietarioCooperadoId], references: [id])
  // Bloco H': contrato/dados PJ titular junto à distribuidora
  cnpjUsina               String?
  formaAquisicao          FormaAquisicao?
  formaPagamentoDono      FormaPagamentoDono?
  valorAluguelFixo        Decimal?                  @db.Decimal(10, 2)
  percentualGeracaoDono   Decimal?                  @db.Decimal(5, 2)
  numeroContratoEdp       String?
  dataContratoEdp         DateTime?
  // Nota Bloco H' (16/05/2026): classeGd / RegrasFioB / guards de classificação NÃO foram
  // adicionados aqui de propósito — sistema permanece neutro enquanto litígio CoopereBR×EDP corre.
  // Tudo isso fica em Sprint "Módulo Classificação GD" separado, plugável pós-dossiê.
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  contratos               Contrato[]
  configuracoesCobranca   ConfiguracaoCobranca[]
  geracoesMensais         GeracaoMensal[]
  monitoramentoConfig     UsinaMonitoramentoConfig?
  leituras                UsinaLeitura[]
  alertas                 UsinaAlerta[]
  contratosUso            ContratoUso[]
  contasAPagar            ContaAPagar[]
  repassesProprietario    RepasseProprietario[]
  enviosLista             EnvioListaConcessionaria[]
  // Sprint Usinas+Listas Sub-Fase 1 (17/05/2026 noite) — campo informativo opcional,
  // sem guard, registra a classificação GD I/II/III enquanto litígio CoopereBR×EDP corre.
  classeGdAnotada         String?
  convitesProprietario    ConviteProprietario[]

  // ── Sub-Sprint F (M30, 2026-05-26) — Portal Proprietario ─────────
  // Override por usina da tarifa de referencia pro calculo PERCENTUAL/HIBRIDO
  // do repasse ao dono. Se null, helper calcularRepasse usa
  // TarifaConcessionaria.tusdNova + teNova como fallback.
  valorKwhPadrao          Decimal?                  @db.Decimal(10, 5)

  // Matriz de responsabilidade por categoria de despesa (PARCEIRO/PROPRIETARIO/COMPARTILHADO).
  // Shape: { "CUSD": "PARCEIRO", "MANUTENCAO_CORRETIVA": "PROPRIETARIO", ... }
  // Default vazio — Luciano preenche via UI admin por usina.
  responsabilidadeDespesas Json                     @default("{}")

  // Status operacional real-time (separado do statusHomologacao que e ciclo de vida).
  // Atualizado automaticamente via UsinaLeitura.statusOnline quando cron Sungrow ativo;
  // override manual sempre disponivel pro admin via UI.
  statusOperacional       StatusOperacional         @default(OPERANDO)

  @@map("usinas")
}

// Sub-Sprint F (M30, 2026-05-26) — status operacional real-time da usina.
// Espelha tbl_usina.status_usina Boolean do legado SISGDSOLAR mas com mais granularidade.
enum StatusOperacional {
  OPERANDO                // Usina gerando normalmente
  MANUTENCAO_PLANEJADA    // Admin marcou manutencao programada — nao alertar
  MANUTENCAO_EMERGENCIAL  // Falha detectada exigindo intervencao urgente
  DESLIGADA               // Desligada permanentemente (ex: contratual)
  OFFLINE                 // Sem comunicacao com inversor (alerta automatico)
}

// Sub-Sprint F (M30, 2026-05-26) — magic link de uso unico pra onboarding
// de proprietario de usina nao-cooperado (ex: E-Solares). Admin envia
// convite por email; proprietario clica, define senha, ativa Usuario.
model ConviteProprietario {
  id          String    @id @default(cuid())
  usinaId     String
  usina       Usina     @relation(fields: [usinaId], references: [id])
  token       String    @unique
  email       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String    // userId do admin que enviou
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@map("convites_proprietario")
}

// Bloco H' (16/05/2026) — modalidade de aquisição da usina pela cooperativa.
enum FormaAquisicao {
  CESSAO   // cooperativa recebeu cessão de uso da usina por terceiro
  ALUGUEL  // cooperativa aluga (arrenda) a usina
  PROPRIA  // usina é da própria cooperativa
}

// Bloco H' (16/05/2026) — como o dono da usina é remunerado pela cooperativa.
enum FormaPagamentoDono {
  FIXO        // valor fixo mensal acordado em contrato
  PERCENTUAL  // % sobre receita/geração
  HIBRIDO     // valor fixo mensal + % sobre geração (ambos juntos — mini-bloco H'.9, 17/05/2026)
}

enum StatusUsina {
  CADASTRADA
  AGUARDANDO_HOMOLOGACAO
  HOMOLOGADA
  EM_PRODUCAO
  SUSPENSA
}

model Contrato {
  id                       String                    @id @default(cuid())
  numero                   String                    @unique
  cooperadoId              String
  cooperado                Cooperado                 @relation(fields: [cooperadoId], references: [id])
  ucId                     String
  uc                       Uc                        @relation(fields: [ucId], references: [id])
  usinaId                  String?
  usina                    Usina?                    @relation(fields: [usinaId], references: [id])
  planoId                  String?
  plano                    Plano?                    @relation(fields: [planoId], references: [id])
  propostaId               String?
  proposta                 PropostaCooperado?        @relation(fields: [propostaId], references: [id])
  dataInicio               DateTime
  dataFim                  DateTime?
  /// Preenchido pelo trigger envio-lista quando cooperado é HOMOLOGADO pela concessionária
  /// e contrato transita de PENDENTE_ATIVACAO → ATIVO (Sub-Fase 1 Fase 4, 18/05/2026).
  dataAtivacao             DateTime?
  percentualDesconto       Decimal                   @db.Decimal(5, 2)
  kwhContrato              Decimal?                  @db.Decimal(10, 5)
  percentualUsina          Decimal?                  @db.Decimal(8, 4)
  status                   StatusContrato            @default(PENDENTE_ATIVACAO)
  modeloCobrancaOverride   ModeloCobranca?
  kwhContratoAnual         Decimal?                  @db.Decimal(15, 2)
  kwhContratoMensal        Decimal?                  @db.Decimal(15, 2)
  descontoOverride         Decimal?                  @db.Decimal(5, 2)
  baseCalculoOverride      String?
  regrasAplicadas          Json?
  cooperativaId            String?
  cooperativa              Cooperativa?              @relation("ContratoCooperativa", fields: [cooperativaId], references: [id])
  ultimoReajusteEm         DateTime?
  ultimoReajusteIndice     String?
  // ── Sprint 5: campos pra refatoração da engine de cobrança ──
  valorContrato                Decimal?                  @db.Decimal(10, 2)
  /// Snapshot pós-desconto (Decisão B33, 03/05/2026): valor R$/kWh que o cooperado paga.
  /// Já considera plano.baseCalculo + plano.descontoBase no momento do aceite.
  /// NUNCA aplicar desconto de novo em cima deste campo na engine consumidora.
  /// CREDITOS_COMPENSADOS: cobrança = kwhCompensado × tarifaContratual.
  tarifaContratual             Decimal?                  @db.Decimal(10, 5)
  dataUltimoReajusteTarifa     DateTime?
  // Snapshots adicionais do plano — preenchidos em aceitar()
  valorContratoPromocional     Decimal?                  @db.Decimal(10, 2)
  /// Idem tarifaContratual, mas durante período promocional (mesesPromocao).
  /// Também é pós-desconto. Engine não aplica desconto extra.
  tarifaContratualPromocional  Decimal?                  @db.Decimal(10, 5)
  /// Snapshot do valor cheio do kWh (Total fatura ÷ kWh) na fatura usada no aceite.
  /// Fase B.5 (03/05/2026): FIXO_MENSAL usa pra calcular valorBruto/economia
  /// retroativamente (cobrança fixa não tem fatura mensal pra olhar).
  /// COMPENSADOS/DINAMICO também gravam pra histórico/auditoria.
  valorCheioKwhAceite          Decimal?                  @db.Decimal(10, 5)
  descontoPromocionalAplicado  Decimal?                  @db.Decimal(5, 2)
  mesesPromocaoAplicados       Int?
  baseCalculoAplicado          String                    @default("KWH_CHEIO")
  tipoDescontoAplicado         TipoDesconto              @default(APLICAR_SOBRE_BASE)
  /// Classe GD aplicada à cobrança deste contrato (Caminho B — Sprint 8 + Sprint 5a Neutro).
  /// Input manual do admin até Sprint 5 completo (dossiê judicial CoopereBR × EDP fechar).
