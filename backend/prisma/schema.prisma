// ─────────────────────────────────────────────────────────────────────
// Bloco 5 Sprint Bot Autoatendimento (24/05/2026)
//
// Cooperado pede via WhatsApp alteracao no contrato (aumentar/diminuir
// kWh, suspender, encerrar). Decisao Luciano: bot NAO altera contrato
// direto — cria SolicitacaoAlteracaoContrato PENDENTE; equipe valida
// pela tela /dashboard/super-admin/solicitacoes e aprova/recusa.
// Aprovar = aplicar imediato (contratosService.update + status APLICADA).
// Multi-tenant via cooperativaId em todas as queries.
// ─────────────────────────────────────────────────────────────────────

enum TipoAlteracaoContrato {
  AUMENTAR_KWH
  DIMINUIR_KWH
  SUSPENDER
  ENCERRAR
}

enum StatusSolicitacaoContrato {
  PENDENTE
  APROVADA  // reservado pra fluxo 2-fases futuro; hoje pula direto pra APLICADA
  APLICADA  // contrato foi atualizado de fato (aprovar=aplicar imediato)
  RECUSADA
  CANCELADA // cooperado cancelou via bot (futuro)
}

model SolicitacaoAlteracaoContrato {
  id                String                    @id @default(cuid())
  cooperadoId       String
  cooperado         Cooperado                 @relation(fields: [cooperadoId], references: [id])
  cooperativaId     String
  cooperativa       Cooperativa               @relation(fields: [cooperativaId], references: [id])
  contratoId        String
  contrato          Contrato                  @relation(fields: [contratoId], references: [id])
  tipoAlteracao     TipoAlteracaoContrato
  // Campos por tipo (todos opcionais — so relevantes pro tipo)
  valorPropostoKwh  Int?     // AUMENTAR_KWH | DIMINUIR_KWH
  motivo            String?  // opcional pra todos (sugerido SUSPENDER/ENCERRAR)
  // Workflow
  status            StatusSolicitacaoContrato @default(PENDENTE)
  createdAt         DateTime                  @default(now())
  processadaEm      DateTime?
  processadaPorId   String?  // FK logico pra Usuario admin (string solta, padrao do projeto)
  observacoesEquipe String?
  aplicadaEm        DateTime? // quando contratosService.update rodou de fato

  @@map("solicitacoes_alteracao_contrato")
  @@index([cooperativaId, status]) // pra listar pendentes por tenant
  @@index([cooperadoId])            // pra historico do cooperado
}

// ─────────────────────────────────────────────────────────────────────
// Bloco 8 Sprint Bot Autoatendimento (24/05/2026) — "Já paguei" do bot
// Cooperado avisa via WhatsApp que pagou a fatura (PIX direto fora do
// gateway, transferencia, deposito etc). Bot NAO da baixa direto na
// Cobranca — cria SolicitacaoConfirmacaoPagamento PENDENTE; equipe valida
// no painel admin /dashboard/super-admin/solicitacoes (genericalizado pra
// listar SolicitacaoAlteracaoContrato + SolicitacaoConfirmacaoPagamento).
// Aprovar = marca CONFIRMADA + opcionalmente da baixa na Cobranca.
// Multi-tenant via cooperativaId em todas as queries.
// ─────────────────────────────────────────────────────────────────────

enum StatusSolicitacaoConfirmacaoPagamento {
  PENDENTE
  CONFIRMADA
  RECUSADA
}

model SolicitacaoConfirmacaoPagamento {
  id                       String                                @id @default(cuid())
  cooperadoId              String
  cooperado                Cooperado                             @relation(fields: [cooperadoId], references: [id])
  cooperativaId            String
  cooperativa              Cooperativa                           @relation(fields: [cooperativaId], references: [id])
  cobrancaId               String
  cobranca                 Cobranca                              @relation(fields: [cobrancaId], references: [id])
  valorReclamado           Decimal?                              @db.Decimal(10, 2)
