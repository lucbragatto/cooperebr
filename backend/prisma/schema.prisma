  codigoResgate String      @unique // UUID de confirmação
  validado      Boolean     @default(false)
  validadoEm    DateTime?
  createdAt     DateTime    @default(now())

  @@index([cooperadoId])
  @@index([cooperativaId])
  @@index([codigoResgate])
  @@map("resgates_clube_vantagens")
}

// ── Histórico de Status do Cooperado (P2-1) ──

model HistoricoStatusCooperado {
  id             String       @id @default(cuid())
  cooperadoId    String
  cooperado      Cooperado    @relation(fields: [cooperadoId], references: [id])
  cooperativaId  String?
  cooperativa    Cooperativa? @relation(fields: [cooperativaId], references: [id])
  statusAnterior String
  statusNovo     String
  motivo         String?
  usuarioId      String?
  createdAt      DateTime     @default(now())

  @@index([cooperadoId])
  @@index([cooperativaId])
  @@map("historico_status_cooperado")
}

// ── Contas a Pagar (P2-2) ──

enum CategoriaContaAPagar {
  ARRENDAMENTO_USINA
  MANUTENCAO
  SALARIO
  OUTRO
  // Sub-Sprint F (M30, 2026-05-26) — categorias granulares por usina
  CUSD                      // Custo de uso do sistema de distribuicao
  MANUTENCAO_PREVENTIVA
  MANUTENCAO_CORRETIVA
  ROCADA
  VIGILANCIA
  SEGURO
  IPTU_ITR                  // IPTU urbano ou ITR rural
  CONSUMO_AUXILIAR          // Energia auxiliar da usina (escritorio, monitoramento)
  INTERNET
  ACOMPANHAMENTO_TECNICO
  EQUIPAMENTOS              // Reposicao/upgrade de inversor, modulos, etc
}

enum StatusContaAPagar {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

// Sub-Sprint F (M30, 2026-05-26) — responsavel por pagar a despesa.
// COMPARTILHADO indica rateio entre parceiro e proprietario (regra acordada
// contratualmente, fora do escopo do MVP+).
enum ResponsavelPagamento {
  PARCEIRO
  PROPRIETARIO
  COMPARTILHADO
}

// ── D-novo-BH (M37, 2026-05-29) — Workflow Camada 2 Despesas Operacionais ──

enum StatusAprovacaoDespesa {
  PROPOSTA    // proprietário propôs, admin precisa aprovar
  APROVADA    // admin aprovou OU lançou direto (default legacy)
  REJEITADA   // admin rejeitou com motivo
}

enum TratamentoDespesa {
  REEMBOLSO              // cooperativa reembolsa proprietário (ou vice-versa)
  DESCONTO_NO_REPASSE    // abate do próximo repasse mensal (consumido em BH.5)
  ASSUMIDO               // quem pagou, assumiu — sem reembolso/desconto
}

enum QuemPagouTipo {
  PARCEIRO       // cooperativa pagou
  PROPRIETARIO   // dono da usina pagou
  COMPARTILHADO  // rateado contratualmente
  TERCEIRO       // terceira parte (ex: empresa manutenção, seguradora)
}

enum StatusResolucaoDespesa {
  PENDENTE   // ainda não resolvida (reembolso não feito / desconto não aplicado / assumido sem confirmação)
  RESOLVIDA  // tratamento contratual concluído
}

model ContaAPagar {
  id             String               @id @default(cuid())
  cooperativaId  String
  cooperativa    Cooperativa          @relation(fields: [cooperativaId], references: [id])
  descricao      String
  categoria      CategoriaContaAPagar
  valor          Decimal              @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusContaAPagar    @default(PENDENTE)
  usinaId        String?
  usina          Usina?               @relation(fields: [usinaId], references: [id])
  comprovante    String?
  // Sub-Sprint F: quem efetivamente paga (deduzido da Usina.responsabilidadeDespesas
  // ou sobrescrito manualmente na criacao da conta).
  responsavelPagamento ResponsavelPagamento?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // ── D-novo-BH (M37, 2026-05-29) — Workflow aprovação ──
  statusAprovacao       StatusAprovacaoDespesa @default(APROVADA) // legacy default APROVADA
  propostoPorUsuarioId  String?
  propostoPor           Usuario? @relation("DespesaPropostoPor", fields: [propostoPorUsuarioId], references: [id])
  aprovadoPorUsuarioId  String?
  aprovadoPor           Usuario? @relation("DespesaAprovadoPor", fields: [aprovadoPorUsuarioId], references: [id])
  aprovadoEm            DateTime?
  rejeitadoMotivo       String?

  // ── D-novo-BH — Tratamento contratual ──
  tratamento            TratamentoDespesa?  // null = legacy (sem tratamento definido)
  quemPagouTipo         QuemPagouTipo?      // null = legacy
  quemPagouNome         String?             // opcional, nome do TERCEIRO ou descrição livre

  // ── D-novo-BH — Resolução (separada de status financeiro) ──
  statusResolucao       StatusResolucaoDespesa @default(PENDENTE)
  resolvidoEm           DateTime?

  // ── D-novo-BH — Dados temporais e vínculos ──
  dataOcorrencia        DateTime?            // quando despesa OCORREU (vs dataVencimento que é quando VENCE)
  // D-novo-AN (M42, 2026-05-30) — vínculo bidirecional ao RepasseProprietario que abateu.
  repasseAbatidoId      String?
  repasseAbatido        RepasseProprietario? @relation("RepasseAbatido", fields: [repasseAbatidoId], references: [id])

  @@index([cooperativaId])
  @@index([status])
  @@index([dataVencimento])
  @@index([statusAprovacao])
  @@index([statusResolucao])
  @@index([usinaId, statusAprovacao])
  @@index([repasseAbatidoId])
  @@map("contas_a_pagar")
}

// ── D-novo-AN (M42, 2026-05-30) — RepasseProprietario ──
// Registra o pagamento real do aluguel/repasse ao proprietário da usina,
// complementando BH.5 (que só registra a obrigação ARRENDAMENTO_USINA via
// ContaAPagar). Cron BH.5 cria PENDENTE no mesmo trigger; admin marca PAGO
// e, em transação atômica, vincula despesas DESCONTO_NO_REPASSE pendentes
// do período via `ContaAPagar.repasseAbatidoId`.

enum StatusRepasseProprietario {
  PENDENTE   // criado pelo cron, aguardando pagamento real do admin
  PAGO       // admin registrou pagamento (data + método + comprovante opcional)
  CANCELADO  // contrato encerrado / contestação / acerto fora do sistema
}

enum MetodoPagamentoRepasse {
  PIX
  TED
  MANUAL  // boleto bancário tradicional, depósito
  OUTRO   // exige `observacao`
}

model RepasseProprietario {
  id                       String   @id @default(cuid())
  cooperativaId            String
  cooperativa              Cooperativa @relation(fields: [cooperativaId], references: [id])
  usinaId                  String
  usina                    Usina    @relation(fields: [usinaId], references: [id])

  // Proprietário pode estar sem Usuario cadastrado (Caminho B sem onboarding completo).
  proprietarioUsuarioId    String?
  proprietarioUsuario      Usuario? @relation("RepasseProprietarioUsuario", fields: [proprietarioUsuarioId], references: [id])

  // Período de apuração — fechado [inicio, fim].
  periodoInicio            DateTime
  periodoFim               DateTime

  // Valores apurados no momento da criação (snapshot — não recalcula depois).
  valorBruto               Decimal  @db.Decimal(10, 2)
  totalDespesasAbatidas    Decimal  @db.Decimal(10, 2) @default(0)
  valorLiquido             Decimal  @db.Decimal(10, 2)

  status                   StatusRepasseProprietario @default(PENDENTE)

  // Preenchidos quando admin marca PAGO.
  metodoPagamento          MetodoPagamentoRepasse?
  dataPagamento            DateTime?
  comprovante              String?  // URL upload (reusa pattern /uploads/ BH.3.1)
  observacao               String?

  registradoPorUsuarioId   String?
  registradoPor            Usuario? @relation("RepasseRegistradoPor", fields: [registradoPorUsuarioId], references: [id])

  // Preenchidos quando admin cancela.
  canceladoPorUsuarioId    String?
  canceladoPor             Usuario? @relation("RepasseCanceladoPor", fields: [canceladoPorUsuarioId], references: [id])
  canceladoEm              DateTime?
  motivoCancelamento       String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Despesas DESCONTO_NO_REPASSE abatidas quando este repasse foi marcado PAGO.
  despesasAbatidas         ContaAPagar[] @relation("RepasseAbatido")

  @@unique([usinaId, periodoInicio, periodoFim]) // idempotência forte (cron BH.5)
  @@index([cooperativaId])
  @@index([proprietarioUsuarioId])
  @@index([status])
  @@index([usinaId, status])
  @@map("repasses_proprietario")
}

// ── Bandeira Tarifária (Sprint 4) ──

model BandeiraTarifaria {
  id             String      @id @default(cuid())
  cooperativaId  String
  cooperativa    Cooperativa @relation(fields: [cooperativaId], references: [id])
  tipo           String
  valorPor100Kwh Decimal     @db.Decimal(10, 4)
  dataInicio     DateTime
  dataFim        DateTime
  observacao     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([cooperativaId, dataInicio, dataFim])
  @@map("bandeiras_tarifarias")
}

// ═══════════════════════════════════════════════════════════════════════════
// Sprint Usinas+Listas Concessionária Sub-Fase 1 (17/05/2026 noite)
// Esqueleto operacional do fluxo de 9 etapas (memória `spec_modulo_listas_concessionaria_17_05.md`):
// RASCUNHO → VALIDADA → PRONTA_PARA_ENVIO → ENVIADA → PROTOCOLADA → HOMOLOGADO_PARCIAL/TOTAL.
// numeroInterno: LIST-{apelidoInterno||id.slice(0,6)}-YYYYMM-NNN (decisão 17/05).
// classeGdAnotada vive em Usina (informativo, sem guard). D-novo-H trata convenção mensal depois.
// ═══════════════════════════════════════════════════════════════════════════

model EnvioListaConcessionaria {
  id                              String                    @id @default(cuid())
  numeroInterno                   String                    @unique // LIST-{usinaApelido||id6}-YYYYMM-NNN
  cooperativaId                   String
  cooperativa                     Cooperativa               @relation(fields: [cooperativaId], references: [id])
  usinaId                         String
  usina                           Usina                     @relation(fields: [usinaId], references: [id])
  status                          StatusEnvioConcessionaria @default(RASCUNHO)

  geradaEm                        DateTime                  @default(now())
  validadaEm                      DateTime?
  validadaPorId                   String?
  validadaPor                     Usuario?                  @relation("EnvioListaValidador", fields: [validadaPorId], references: [id])
  enviadaEm                       DateTime?
  enviadaPorId                    String?
  enviadaPor                      Usuario?                  @relation("EnvioListaEnviador", fields: [enviadaPorId], references: [id])
  canalEnvio                      String? // "email" | "portal" | "fisico"
  protocoloEm                     DateTime?
  numeroProtocoloConcessionaria   String?
  liberadaEm                      DateTime?
  observacoes                     String?

  cooperados                      EnvioListaCooperado[]

  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@index([cooperativaId, status])
  @@index([usinaId, geradaEm])
  @@map("envios_lista_concessionaria")
}

model EnvioListaCooperado {
  id                       String                   @id @default(cuid())
  envioId                  String
  envio                    EnvioListaConcessionaria @relation(fields: [envioId], references: [id], onDelete: Cascade)
  contratoId               String
  contrato                 Contrato                 @relation(fields: [contratoId], references: [id])
  cooperadoId              String
  cooperado                Cooperado                @relation(fields: [cooperadoId], references: [id])
  ucNumero                 String
  // Snapshot imutável dos valores no momento da validação (alinhado com Contrato.percentualUsina Decimal(8,4))
  kwhContratoSnapshot      Decimal                  @db.Decimal(15, 2)
  percentualUsinaSnapshot  Decimal                  @db.Decimal(8, 4)
  statusIndividual         StatusEnvioCooperado     @default(PENDENTE)
  dataHomologacao          DateTime?
  observacaoIndividual     String?
  createdAt                DateTime                 @default(now())

  @@index([envioId, statusIndividual])
  @@index([cooperadoId, statusIndividual])
  @@map("envio_lista_cooperados")
}

enum StatusEnvioConcessionaria {
  RASCUNHO
  VALIDADA
  PRONTA_PARA_ENVIO
  ENVIADA
  PROTOCOLADA
  HOMOLOGADO_PARCIAL
  HOMOLOGADO_TOTAL
  REJEITADA
  CANCELADA
}

enum StatusEnvioCooperado {
  PENDENTE
  HOMOLOGADO
  REJEITADO
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 8 / Bloco E — Realocação Multi-Usina (Engine Otimização Proativa)
// Catalogado 18/05/2026 (M14.A).
// ─────────────────────────────────────────────────────────────────────────

/// Classe GD aplicada (input manual no Contrato — Caminho B aprovado 18/05/2026
/// em `decisao_caminho_b_fio_b_neutro_18_05.md`). Quando Sprint 5 completo rodar
/// (pós-dossiê judicial), passa a herdar de `Usina.classeGd`.
enum ClasseGdAplicada {
  GD_I    // <75 kW (microgeração)
  GD_II   // 75kW-500kW (minigeração I)
  GD_III  // 500kW-5MW (minigeração II)
}

enum StatusAlocacaoOtima {
  SUGERIDA
  APROVADA_PARCIAL
  APROVADA_TOTAL
  DESCARTADA
}

/// Política de alocação configurável por parceiro — define faixas de consumo
/// e suas classes GD preferidas + usinas elegíveis. Engine consulta para
/// orientar otimização. Política padrão SISGD é seedada inicialmente.
model PoliticaAlocacao {
  id                String            @id @default(cuid())
  cooperativaId     String
  cooperativa       Cooperativa       @relation(fields: [cooperativaId], references: [id])
  nome              String            // "Pequenos GD_II", "Médios GD_I/II", etc
  faixaMin          Decimal           @db.Decimal(10, 2)  // kWh/mês mínimo (inclusive)
  faixaMax          Decimal?          @db.Decimal(10, 2)  // kWh/mês máximo (inclusive); null = sem teto
  classeGdPreferida ClasseGdAplicada?
  usinasElegiveis   String[]          @default([])       // IDs de usinas elegíveis (vazio = todas da cooperativa)
  prioridade        Int               @default(0)         // ordem de aplicação quando múltiplas matcham (maior primeiro)
  ativa             Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([cooperativaId, ativa, prioridade])
  @@map("politicas_alocacao")
}

/// Snapshot de uma simulação de otimização de alocação. Engine grava antes
/// de aplicar; admin aprova caso a caso via UI.
model AlocacaoOtima {
  id                   String              @id @default(cuid())
  cooperativaId        String
  cooperativa          Cooperativa         @relation(fields: [cooperativaId], references: [id])
  calculadaEm          DateTime            @default(now())
  /// Snapshot completo: { realocacoes: [{ contratoId, usinaAtualId, usinaSugeridaId, economiaProjetada, motivos[] }],
  ///   custoTotalAntes, custoTotalDepois, economiaTotal, contratosAvaliados, realocacoesSugeridas }
  snapshot             Json
  status               StatusAlocacaoOtima @default(SUGERIDA)
  aprovadasContratoIds String[]            @default([])     // IDs dos contratos cujas realocações foram efetivamente aplicadas
  observacoes          String?
  geradaPorUserId      String?
  aprovadaPorUserId    String?
  aplicadaEm           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([cooperativaId, status, calculadaEm])
  @@map("alocacoes_otimas")
}

// =================================================================
// Sprint CT.1 (31/05/2026) — Contabilidade Tributária Segregada
// Especificação: docs/especificacao-contabilidade-cooperativa-segregada.md
// Conformidade multi-regime: docs/relatorios/2026-05-31-conformidade-contabil-multi-regime.md
// Auditoria 58 legados: docs/relatorios/2026-05-31-auditoria-53-lancamentos-legados.md
// =================================================================

/// Regime contábil-tributário do parceiro. Derivado de tipoParceiro no
/// cadastro. CT.1 implementa só COOPERATIVO em produção; outros = stub
/// (esquema preparado pra ativar quando onboarding real desses tipos exigir).
enum TipoRegimeContabil {
  COOPERATIVO                    // Lei 5.764/71 — ato cooperativo, fundos, sobras
  CONSORCIO_PROPORCIONAL         // Lei 6.404/76 + Lei 14.300/2022 — proporcional por consorciada
  ASSOCIACAO_SEM_FINS_LUCRATIVOS // CC Arts. 53-61 + Lei 9.532/97
  CONDOMINIO_EDILICIO            // CC Arts. 1.314-1.358-A + Lei 14.300/2022
}

/// Natureza do ato cooperativo (Lei 5.764/71 Arts. 79, 86, 88).
/// Migration String → enum em LancamentoCaixa (CT.1 Passo 1+2).
enum NaturezaCooperativa {
  PROPRIO         // Art. 79 — cooperativa × cooperado pra consecução objeto social
  AUXILIAR        // Art. 88 — terceiro necessário (convênio custeio)
  NAO_COOPERATIVO // Art. 86 — terceiro sem vínculo cooperativo
}

/// Natureza contábil da conta no plano segregado.
/// Sobras separada de Resultado Não-Coop (risco 3 do parecer subagent).
enum NaturezaContabil {
  ATIVO
  PASSIVO
  PATRIMONIO_LIQUIDO
  RECEITA_ATO_PROPRIO
  RECEITA_ATO_AUXILIAR
  RECEITA_NAO_COOPERATIVO
  DESPESA_ATO_PROPRIO
  DESPESA_ATO_AUXILIAR
  DESPESA_NAO_COOPERATIVO
  FUNDOS_OBRIGATORIOS         // FATES + Fundo de Reserva (Art. 28)
  SOBRAS_DISTRIBUIVEIS        // separado de RESULTADO_NAO_COOPERATIVO
  RESULTADO_NAO_COOPERATIVO   // tributável; vai pro FATES (Art. 87)
}

/// Status da apuração mensal. Após FECHADA, snapshot é imutável (defensabilidade
/// fiscal — conformidade item #3 do parecer subagent).
enum StatusApuracao {
  ABERTA
  FECHADA
}

/// Tipo de benefício do Convenio. CT.1 libera só ENERGIA_SCEE em produção
/// (Decisão Luciano 17/05). Outros tipos = schema-only + flag de feature.
enum TipoBeneficioConvenio {
  ENERGIA_SCEE
  // Stubs pra ativar por demanda real:
  // SAUDE
  // ALIMENTACAO
  // REFEICAO
  // CONSIGNADO
  // MOBILIDADE_ELETRICA
  // OUTROS
}

/// Fluxo financeiro do Convenio — define a natureza contábil do lançamento.
enum FluxoConvenio {
  INGRESSO_CUSTEIO_AUXILIAR     // aporte recebido = receita auxiliar
  REPASSE_PROVEDOR_EXTERNO      // saída pra provedor = despesa auxiliar
  CUSTO_OPERACIONAL_INTERNO     // custo operacional do convênio = despesa auxiliar
}

/// Convenio formal entre cooperativa e provedor/cooperados (Art. 88 Lei 5.764/71).
/// Diferente de ContratoConvenio (que é foco MLM/desconto). Este model é
/// exclusivo da contabilidade tributária — fluxo entrada=saída sem retenção
/// pra que seja Auxiliar não-tributado.
model Convenio {
  id                  String                @id @default(cuid())
  cooperativaId       String
  cooperativa         Cooperativa           @relation(fields: [cooperativaId], references: [id])
  nome                String
  descricao           String?
  tipoBeneficio       TipoBeneficioConvenio @default(ENERGIA_SCEE)
  fluxoFinanceiro     FluxoConvenio
  /// Texto livre citando fundamento legal e classificação fiscal
  /// (ex: "Ato Auxiliar Art. 88 Lei 5.764/71 + STF Tema 536").
  classificacaoFiscal String
  vigenciaInicio      DateTime
  vigenciaFim         DateTime?
  ativo               Boolean               @default(true)
  observacoes         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([cooperativaId, ativo])
  @@index([cooperativaId, tipoBeneficio])
  @@map("convenios_contabilidade")
}

/// Snapshot mensal da apuração contábil-tributária segregada por tenant.
/// IMUTÁVEL após FECHADA (defensabilidade fiscal — conformidade item #3
/// do parecer subagent). Valores em snapshot — não recalcular após fechar.
///
/// CT.1 cria o modelo; CT.4 implementa o motor de cálculo real (gate Walter).
model ApuracaoMensalSegregada {
  id                  String         @id @default(cuid())
  cooperativaId       String
  cooperativa         Cooperativa    @relation(fields: [cooperativaId], references: [id])
  ano                 Int
  mes                 Int

  // ── Receitas/Despesas por natureza (snapshot Decimal pra precisão fiscal) ──
  receitaPropria      Decimal        @default(0) @db.Decimal(15, 2)
  receitaAuxiliar     Decimal        @default(0) @db.Decimal(15, 2)
  receitaNaoCoop      Decimal        @default(0) @db.Decimal(15, 2)
  despesaPropria      Decimal        @default(0) @db.Decimal(15, 2)
  despesaAuxiliar     Decimal        @default(0) @db.Decimal(15, 2)
  despesaNaoCoop      Decimal        @default(0) @db.Decimal(15, 2)

  // ── Fundos obrigatórios Lei 5.764/71 Art. 28 (10% Reserva + 5% FATES) ──
  fundoReserva        Decimal        @default(0) @db.Decimal(15, 2)
  fates               Decimal        @default(0) @db.Decimal(15, 2)
  sobrasDistribuiveis Decimal        @default(0) @db.Decimal(15, 2)

  // ── Tributos devidos sobre ato Não-Coop (Próprio = 0 explícito com fundamento) ──
  pisDevido           Decimal        @default(0) @db.Decimal(15, 2)
  cofinsDevido        Decimal        @default(0) @db.Decimal(15, 2)
  irpjDevido          Decimal        @default(0) @db.Decimal(15, 2)
  csllDevido          Decimal        @default(0) @db.Decimal(15, 2)

  /// Fundamento legal da isenção (citação de norma + jurisprudência).
  /// Ex: "STF Tema 536 + STJ Tema 986 + Art. 79 Lei 5.764/71".
  fundamentoIsencao   String?

  status              StatusApuracao @default(ABERTA)
  fechadoEm           DateTime?
  fechadoPorUsuarioId String?
  observacoes         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([cooperativaId, ano, mes])
  @@index([cooperativaId, status])
  @@map("apuracoes_mensais_segregadas")
}
