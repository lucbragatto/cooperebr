model FaturaProcessada {
  id                 String       @id @default(cuid())
  cooperadoId        String?
  cooperado          Cooperado?   @relation(fields: [cooperadoId], references: [id])
  ucId               String?
  uc                 Uc?          @relation(fields: [ucId], references: [id])
  arquivoUrl         String?
  dadosExtraidos     Json
  historicoConsumo   Json
  mesesUtilizados    Int
  mesesDescartados   Int
  mediaKwhCalculada  Decimal      @db.Decimal(10, 2)
  thresholdUtilizado Decimal      @db.Decimal(5, 2)
  status             StatusFatura @default(PENDENTE)
  cooperativaId      String?
  // ── CooperToken ──
  tokenApurado       Boolean      @default(false)
  // ── Central de Faturas ──
  analise            Json?
  mesReferencia      String?
  statusRevisao      String       @default("PENDENTE_REVISAO")
  cobrancaGeradaId   String?
  // ── Saldos e economia (P1-2) ──
  saldoKwhAnterior   Decimal?     @db.Decimal(10, 2)
  saldoKwhAtual      Decimal?     @db.Decimal(10, 2)
  validadeCreditos   DateTime?
  valorSemDesconto   Decimal?     @db.Decimal(10, 2)
  economiaGerada     Decimal?     @db.Decimal(10, 2)
  // ── Fase B (Decisão B33, 03/05/2026): snapshots da fatura para engines COMPENSADOS/DINAMICO ──
  // valorCheioKwh = Total fatura ÷ kWh consumidos (R$/kWh com todos tributos).
  // tarifaSemImpostos = TUSD + TE direto da fatura (R$/kWh sem ICMS/PIS/COFINS).
  // Usados pelas engines COMPENSADOS (referência pra cálculo de economia exibida)
  // e DINAMICO (recálculo da tarifa contratada a cada mês). Salvos na aprovação.
  valorCheioKwh      Decimal?     @db.Decimal(10, 5)
  tarifaSemImpostos  Decimal?     @db.Decimal(10, 5)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("faturas_processadas")
}

