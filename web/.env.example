# Sprint Portal Empresa HOTFIX (04/06/2026) — D-novo-DEV-LAN-ACCESS (P3):
# Em DEV: setar pro IP LAN da máquina (ex: 192.168.3.88) pra que o convite
# por WA possa abrir o link no celular do convidado (que NÃO conhece localhost).
# Em PROD: domínio público (https://app.cooperebr.com.br).
# ⚠️ NEXT_PUBLIC_* é baked no build do Next.js — REBUILD obrigatório após
# mudar (HMR não pega env).
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=http://localhost:3002

# Modo teste — bypassa validacoes no cadastro (NUNCA true em prod)
NEXT_PUBLIC_MODO_TESTE=false

# Sprint Portal Empresa 9.0 (04/06/2026) — flag dev-only do box de credenciais.
# false (default) → box aparece no /login. true → box escondido (produção).
NEXT_PUBLIC_AMBIENTE_REAL=false
